# Template for the local .env file. Copy it, fill in the real values, and never commit .env.
#
#   cp env.example .env
#   source .env
#   python reference/check_maps_key.py
#
# The `export` keyword matters: without it the value stays a shell variable and Python will
# not see it. No quotes, no spaces around the equals sign.
# On Windows PowerShell, set the variable directly instead of sourcing:
#   $env:GOOGLE_MAPS_API_KEY="..."

# Google Cloud key with the Geocoding API and Routes API enabled and restricted to them.
# Read by reference/check_maps_key.py. In Make it goes in module 2, variable maps_key.
export GOOGLE_MAPS_API_KEY=AIza_replace_me

# The Make.com custom webhook URL from module 1, once the scenario is imported.
# Read by reference/check_webhook.py.
export MAKE_WEBHOOK_URL=https://hook.REGION.make.com/replace_me

# The ufound Dispatch calendar id, from Google Calendar settings under Integrate calendar.
# Not a secret and not read by any script; kept here so the value lives in one place.
# In Make it goes in module 2, variable calendar_id.
export UFOUND_CALENDAR_ID=replace_me@group.calendar.google.com
