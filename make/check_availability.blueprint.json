{
  "name": "check_availability",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "Retell: check_availability"
        },
        "restore": {
          "parameters": {
            "hook": {
              "data": {
                "editable": "true"
              },
              "label": "check_availability"
            }
          }
        },
        "parameters": [
          {
            "name": "hook",
            "type": "hook:gateway-webhook",
            "label": "Webhook",
            "required": true
          },
          {
            "name": "maxResults",
            "type": "number",
            "label": "Maximum number of results"
          }
        ],
        "interface": [
          {
            "name": "name",
            "type": "text"
          },
          {
            "name": "args",
            "type": "collection",
            "spec": [
              {
                "name": "trade",
                "type": "text"
              },
              {
                "name": "address",
                "type": "text"
              }
            ]
          },
          {
            "name": "debug",
            "type": "text"
          },
          {
            "name": "call",
            "type": "collection",
            "spec": []
          }
        ]
      }
    },
    {
      "id": 2,
      "module": "util:SetVariables",
      "version": 1,
      "parameters": {},
      "mapper": {
        "variables": [
          {
            "name": "trade",
            "value": "{{1.args.trade}}"
          },
          {
            "name": "tech",
            "value": "{{switch(lower(trim(1.args.trade)); \"plumbing\"; \"tech1@ufound-ai.com\"; \"electrical\"; \"tech2@ufound-ai.com\"; \"hvac\"; \"tech3@ufound-ai.com\"; \"\")}}"
          },
          {
            "name": "address",
            "value": "{{trim(1.args.address)}}"
          },
          {
            "name": "company",
            "value": "4820 Burnet Road, Austin, TX 78756, USA"
          },
          {
            "name": "calendar_id",
            "value": "PASTE_UFOUND_DISPATCH_CALENDAR_ID"
          },
          {
            "name": "maps_key",
            "value": "PASTE_GOOGLE_MAPS_API_KEY"
          },
          {
            "name": "timezone",
            "value": "America/New_York"
          },
          {
            "name": "today",
            "value": "{{formatDate(now; \"YYYY-MM-DD\"; \"America/New_York\")}}"
          },
          {
            "name": "today_spoken",
            "value": "{{formatDate(now; \"dddd, MMMM D\"; \"America/New_York\")}}"
          },
          {
            "name": "now_ts",
            "value": "{{parseNumber(formatDate(now; \"X\"))}}"
          },
          {
            "name": "window_noon",
            "value": "{{setHour(setMinute(setSecond(now; 0; \"America/New_York\"); 0; \"America/New_York\"); 12; \"America/New_York\")}}"
          },
          {
            "name": "debug",
            "value": "{{if(1.debug = \"yes\"; \"yes\"; \"no\")}}"
          }
        ],
        "scope": "roundtrip"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Config & routing"
        }
      }
    },
    {
      "id": 3,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true,
        "useNewZLibDeCompress": true
      },
      "mapper": {
        "url": "https://maps.googleapis.com/maps/api/geocode/json",
        "serializeUrl": false,
        "method": "get",
        "headers": [],
        "qs": [
          {
            "name": "address",
            "value": "{{2.address}}"
          },
          {
            "name": "key",
            "value": "{{2.maps_key}}"
          }
        ],
        "bodyType": "raw",
        "parseResponse": true,
        "authUser": "",
        "authPass": "",
        "timeout": "20",
        "shareCookies": false,
        "ca": "",
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true,
        "useMtls": false,
        "contentType": "application/json",
        "data": "",
        "followAllRedirects": false
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "Maps: geocode caller address"
        }
      },
      "onerror": [
        {
          "id": 31,
          "module": "gateway:WebhookRespond",
          "version": 1,
          "parameters": {},
          "mapper": {
            "status": "200",
            "body": "{\"status\":\"error\",\"trade\":\"{{2.trade}}\",\"technician\":\"{{2.tech}}\",\"timezone\":\"America/New_York\",\"slots\":[],\"slot_count\":0,\"message\":\"The scheduling system is temporarily unavailable. Apologise and tell the caller a team member will call back shortly to schedule.\"}",
            "headers": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "metadata": {
            "designer": {
              "x": 600,
              "y": 220,
              "name": "Respond: error"
            }
          }
        },
        {
          "id": 32,
          "module": "builtin:Ignore",
          "version": 1,
          "mapper": null,
          "metadata": {
            "designer": {
              "x": 900,
              "y": 220
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "module": "util:SetVariables",
      "version": 1,
      "parameters": {},
      "mapper": {
        "variables": [
          {
            "name": "maps_status",
            "value": "{{3.data.status}}"
          },
          {
            "name": "location_type",
            "value": "{{3.data.results[1].geometry.location_type}}"
          },
          {
            "name": "address_ok",
            "value": "{{if(3.data.status = \"OK\"; if(3.data.results[1].geometry.location_type = \"APPROXIMATE\"; \"no\"; \"yes\"); \"no\")}}"
          },
          {
            "name": "resolved_address",
            "value": "{{3.data.results[1].formatted_address}}"
          },
          {
            "name": "lat",
            "value": "{{3.data.results[1].geometry.location.lat}}"
          },
          {
            "name": "lng",
            "value": "{{3.data.results[1].geometry.location.lng}}"
          },
          {
            "name": "fail_status",
            "value": "{{if(3.data.status = \"OK\" or 3.data.status = \"ZERO_RESULTS\" or 3.data.status = \"INVALID_REQUEST\"; \"address_not_found\"; \"error\")}}"
          }
        ],
        "scope": "roundtrip"
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0,
          "name": "Address check"
        }
      }
    },
    {
      "id": 5,
      "module": "builtin:BasicRouter",
      "version": 1,
      "mapper": null,
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0
        }
      },
      "routes": [
        {
          "flow": [
            {
              "id": 6,
              "module": "gateway:WebhookRespond",
              "version": 1,
              "parameters": {},
              "mapper": {
                "status": "200",
                "body": "{\"status\":\"unknown_trade\",\"trade\":\"{{2.trade}}\",\"timezone\":\"America/New_York\",\"slots\":[],\"slot_count\":0,\"message\":\"That job type does not match one of our technicians. Ask one more short question about the problem, then call check_availability again with Plumbing, Electrical or HVAC.\"}",
                "headers": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ]
              },
              "metadata": {
                "designer": {
                  "x": 1500,
                  "y": -400,
                  "name": "Respond: unknown_trade"
                }
              },
              "filter": {
                "name": "Unknown trade",
                "conditions": [
                  [
                    {
                      "a": "{{2.tech}}",
                      "o": "text:equal",
                      "b": ""
                    }
                  ]
                ]
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 7,
              "module": "gateway:WebhookRespond",
              "version": 1,
              "parameters": {},
              "mapper": {
                "status": "200",
                "body": "{\"status\":\"{{4.fail_status}}\",\"trade\":\"{{2.trade}}\",\"technician\":\"{{2.tech}}\",\"timezone\":\"America/New_York\",\"slots\":[],\"slot_count\":0,\"maps_status\":\"{{4.maps_status}}\",\"message\":\"{{if(4.fail_status = \"address_not_found\"; \"The address could not be located. Ask the caller to repeat the street number, street name, city and ZIP code, then call check_availability again.\"; \"The scheduling system is temporarily unavailable. Apologise and tell the caller a team member will call back shortly to schedule.\")}}\"}",
                "headers": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ]
              },
              "metadata": {
                "designer": {
                  "x": 1500,
                  "y": -200,
                  "name": "Respond: address_not_found / error"
                }
              },
              "filter": {
                "name": "Address not found or Maps error",
                "conditions": [
                  [
                    {
                      "a": "{{2.tech}}",
                      "o": "text:notequal",
                      "b": ""
                    },
                    {
                      "a": "{{4.address_ok}}",
                      "o": "text:equal",
                      "b": "no"
                    }
                  ]
                ]
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 8,
              "module": "util:SetVariables",
              "version": 1,
              "parameters": {},
              "mapper": {
                "variables": [
                  {
                    "name": "time_min",
                    "value": "{{formatDate(setHour(setMinute(setSecond(now; 0; \"America/New_York\"); 0; \"America/New_York\"); 0; \"America/New_York\"); \"YYYY-MM-DDTHH:mm:ssZ\"; \"UTC\")}}"
                  },
                  {
                    "name": "time_max",
                    "value": "{{formatDate(addDays(setHour(setMinute(setSecond(now; 0; \"America/New_York\"); 0; \"America/New_York\"); 0; \"America/New_York\"); 14); \"YYYY-MM-DDTHH:mm:ssZ\"; \"UTC\")}}"
                  },
                  {
                    "name": "window_to",
                    "value": "{{formatDate(addDays(2.window_noon; 13); \"YYYY-MM-DD\"; \"America/New_York\")}}"
                  },
                  {
                    "name": "earliest_ts",
                    "value": "{{2.now_ts + 7200}}"
                  }
                ],
                "scope": "roundtrip"
              },
              "metadata": {
                "designer": {
                  "x": 1500,
                  "y": 0,
                  "name": "Time window"
                }
              },
              "filter": {
                "name": "Known trade and valid address",
                "conditions": [
                  [
                    {
                      "a": "{{2.tech}}",
                      "o": "text:notequal",
                      "b": ""
                    },
                    {
                      "a": "{{4.address_ok}}",
                      "o": "text:equal",
                      "b": "yes"
                    }
                  ]
                ]
              }
